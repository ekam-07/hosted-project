# Copy this file to .env and replace the values below.
# Keep this file out of source control and never share secrets publicly.

# For local MongoDB Compass / local server:
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=inventoryDb
PORT=5000

# Daily sales records use this timezone for date-based searches and are retained
# for at least 370 days. Adjust only if the shop operates in another timezone.
SALES_TIME_ZONE=Asia/Kolkata
SALE_RETENTION_DAYS=370

# Required for the admin panel. Never commit the real value.
ADMIN_PASSWORD=replace-with-a-strong-password

# When ready to switch to Atlas, use a URI like:
# MONGODB_URI=mongodb+srv://username:password@cluster0.rrd73kw.mongodb.net/inventoryDb?retryWrites=true&w=majority
